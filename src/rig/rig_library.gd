extends RefCounted
## Part rigs of the 0x72 figures (assets/data/rigs.json, exported from the
## approved review page). Each source frame is split into parts by rects; parts
## and held items get their own textures once. The host uses the rest-pose part
## areas and HP weights for body-part hits; the presentation draws the parts.
## The hell's layered rigs (assets/data/hell_rigs.json, Ignaroth's four forms)
## bring one full-frame PNG (or flipbook) per part instead of rects.
## No node and no singleton: each owner keeps one instance (see shared()).

const DATA_PATH := "res://assets/data/rigs.json"
## Generated by the hell rig tool; optional (a missing file adds no rig).
const HELL_PATH := "res://assets/data/hell_rigs.json"
## Rigs are drawn at 2x, like every other 0x72 sprite in the game.
const PIXEL_SCALE := 2.0
## Floating figures are drawn this many source pixels above their rest pose.
const HOVER := {"necro": 3.0, "void": 5.0, "bomber": 3.0}

static var _shared: RefCounted

## name -> rig Dictionary (see _finish for the fields).
var rigs: Dictionary = {}
var ready := false


## One library per process; building textures is cheap but not free.
static func shared() -> RefCounted:
	if _shared == null:
		_shared = load("res://src/rig/rig_library.gd").new()
		_shared.load_data()
	return _shared


## Loads and builds every rig: the crypt's rigs at `path` and the hell's layered
## rigs at `hell_path`. A missing, half-written or unparsable hell file adds
## nothing and reports no error, so the crypt never depends on it; an empty
## `path` skips the crypt (tests load only a fixture). Returns false when the
## crypt data file is missing or invalid, or when no rig was built at all.
func load_data(path: String = DATA_PATH, hell_path: String = HELL_PATH) -> bool:
	var crypt_ok := path.is_empty() or _load_crypt(path)
	_load_hell(hell_path)
	ready = not rigs.is_empty()
	return crypt_ok and ready


## The rig, or an empty Dictionary for unknown names.
func rig(name: String) -> Dictionary:
	return rigs.get(name, {})


## The attack ids a part (or rig group) disables as a list. Accepts the crypt's
## single string ("attack"), an array of ids (hell rigs) or nothing.
static func disabled_actions(value: Variant) -> Array[String]:
	var result: Array[String] = []
	if value is Array:
		for entry: Variant in value:
			if entry != null and not str(entry).is_empty() and not str(entry) in result: result.append(str(entry))
	elif value != null and not str(value).is_empty():
		result.append(str(value))
	return result


func _load_crypt(path: String) -> bool:
	if not FileAccess.file_exists(path): return false
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not data is Dictionary: return false
	var images: Dictionary = data.get("images", {})
	var art: Dictionary = data.get("pixel_art", {})
	var built_names: Array[String] = []
	for name: String in data.get("rigs", {}):
		var built := _build_rig(name, data.rigs[name], images, art)
		if not built.is_empty():
			rigs[name] = built
			built_names.append(name)
	for extra: String in ["void", "bomber", "mimic"]:
		if not data.has(extra): continue
		match extra:
			"void": rigs["void"] = _build_void(data.void)
			"bomber": rigs["bomber"] = _build_bomber(data.bomber)
			"mimic": rigs["mimic"] = _build_flipbook("mimic", data.mimic, "body")
		built_names.append(extra)
	# Size factors (bosses are drawn 3x): world pixels per source pixel.
	for name: String in built_names: rigs[name].scale = PIXEL_SCALE * float(data.get("scales", {}).get(name, 1.0))
	return true


## Hell rigs are generated in parallel to the game; a file caught mid-write is
## skipped silently (JSON.new().parse does not print, JSON.parse_string does).
## The crypt wins name clashes: a hell rig never replaces a crypt rig (only an
## earlier layered rig of the same name, when the data is loaded again).
func _load_hell(path: String) -> void:
	if path.is_empty() or not FileAccess.file_exists(path): return
	var json := JSON.new()
	if json.parse(FileAccess.get_file_as_string(path)) != OK: return
	var data: Variant = json.data
	if not data is Dictionary or not data.get("rigs") is Dictionary: return
	for name: String in data.rigs:
		if not data.rigs[name] is Dictionary: continue
		if rigs.has(name) and not bool(rigs[name].get("layered", false)):
			push_warning("hell_rigs.json: rig '%s' already exists, skipped" % name)
			continue
		var built := _build_layered(name, data.rigs[name])
		if not built.is_empty(): rigs[name] = built


# --------------------------------------------------------------- building

func _image(path: String) -> Image:
	if path.is_empty() or not ResourceLoader.exists(path): return null
	var texture: Texture2D = load(path)
	if texture == null: return null
	var image := texture.get_image()
	if image == null: return null
	image = image.duplicate()
	if image.is_compressed(): image.decompress()
	image.convert(Image.FORMAT_RGBA8)
	return image


func _pixels(rows: Array, palette: Dictionary) -> Image:
	var image := Image.create(str(rows[0]).length(), rows.size(), false, Image.FORMAT_RGBA8)
	for y in range(rows.size()):
		var row: String = rows[y]
		for x in range(row.length()):
			if palette.has(row[x]): image.set_pixel(x, y, Color(str(palette[row[x]])))
	return image


func _source(key: String, images: Dictionary, art: Dictionary) -> Image:
	if art.has(key): return _pixels(art[key].rows, art[key].palette)
	return _image(str(images.get(key, "")))


func _recolor(image: Image, mapping: Dictionary) -> void:
	var lookup: Dictionary = {}
	for from: String in mapping: lookup[from.trim_prefix("#").to_lower()] = Color(str(mapping[from]))
	for y in range(image.get_height()):
		for x in range(image.get_width()):
			var color := image.get_pixel(x, y)
			if color.a < 0.5: continue
			var key := color.to_html(false).to_lower()
			if lookup.has(key): image.set_pixel(x, y, lookup[key])


func _build_rig(name: String, def: Dictionary, images: Dictionary, art: Dictionary) -> Dictionary:
	var source := _source(str(def.img), images, art)
	if source == null: return {}
	if def.get("recolor") is Dictionary: _recolor(source, def.recolor)
	var w := source.get_width()
	var h := source.get_height()
	var defs: Array = def.get("parts", [])
	var owned: Array[Image] = []
	for _part in defs: owned.append(Image.create(w, h, false, Image.FORMAT_RGBA8))
	for y in range(h):
		for x in range(w):
			var color := source.get_pixel(x, y)
			if color.a < 0.5: continue
			for index in range(defs.size()):
				if _in_rects(defs[index].rects, x, y):
					owned[index].set_pixel(x, y, color)
					break
	var parts: Array[Dictionary] = []
	for index in range(defs.size()):
		var spec: Dictionary = defs[index]
		var part := _layer(owned[index])
		part.merge(_part_fields(spec), true)
		parts.append(part)
	var items: Array[Dictionary] = []
	for spec: Dictionary in def.get("items", []):
		var item_image := _source(str(spec.img), images, art)
		if item_image == null: continue
		# an item of its own colour (the Brandskelett's red blade), on a copy so other rigs keep theirs
		if spec.get("recolor") is Dictionary:
			item_image = item_image.duplicate() as Image
			_recolor(item_image, spec.recolor)
		if bool(spec.get("bow", false)): _remove_bow_string(item_image)
		var item := _layer(item_image)
		item.merge(_part_fields(spec), true)
		item.is_item = true
		item.grip = _vec(spec.grip)
		item.hand = _vec(spec.hand)
		item.rest = float(spec.get("rest", 0.0))
		item.tip = _vec(spec.get("tip", [0, 0]))
		item.bow = bool(spec.get("bow", false))
		item.bounds = _item_bounds(item)
		items.append(item)
	return _finish(name, def, parts, items, source)


func _in_rects(rects: Array, x: int, y: int) -> bool:
	for rect: Array in rects:
		if x >= int(rect[0]) and x <= int(rect[2]) and y >= int(rect[1]) and y <= int(rect[3]): return true
	return false


func _vec(value: Variant) -> Vector2:
	if value is Array and value.size() >= 2: return Vector2(float(value[0]), float(value[1]))
	return Vector2.ZERO


## Host fields of a part spec. "disables" is MIXED-TYPE on purpose: crypt rigs
## (rigs.json) keep their single string ("attack", asserted as text by
## tests/rig_library_test.gd), layered hell rigs always carry Array[String].
## Read it ONLY through RigLibrary.disabled_actions(part.disables): `in` or a
## for loop on the raw field gives substring/character semantics on crypt rigs
## ("tack" in "attack" is true). "weakens" is {attack id: {param: factor}},
## "group" the rig group the part counts for.
func _part_fields(spec: Dictionary) -> Dictionary:
	var disables: Variant = spec.get("disables", "")
	return {"id": str(spec.id), "pivot": _vec(spec.get("pivot", [0, 0])), "parent": str(spec.get("parent", "")) if spec.get("parent") != null else "",
		"z": int(spec.get("z", 0)), "hp": float(spec.get("hp", 0)), "label": str(spec.get("label", spec.id)), "vital": bool(spec.get("vital", false)),
		"disables": disabled_actions(disables) if disables is Array else str(disables if disables != null else ""), "regrow": float(spec.get("regrow", 0)),
		"also_detach": Array(spec.get("alsoDetach", [])), "exposed": str(spec.get("exposed", "")), "unbreakable": bool(spec.get("unbreakable", false)),
		"weakens": _weakens(spec.get("weakens", {})), "group": str(spec.get("group", "")) if spec.get("group") != null else "", "is_item": false,
		"sway": spec.get("sway", []) if spec.get("sway") is Array else []}


## {attack id: {param: factor}} with float factors; anything malformed is dropped.
func _weakens(value: Variant) -> Dictionary:
	var result: Dictionary = {}
	if not value is Dictionary: return result
	for action: Variant in value:
		var params: Variant = value[action]
		if not params is Dictionary: continue
		var factors: Dictionary = {}
		for param: Variant in params:
			var factor: Variant = params[param]
			if factor is int or factor is float or factor is bool: factors[str(param)] = float(factor)
		if not factors.is_empty(): result[str(action)] = factors
	return result


## A drawable layer: texture, white silhouette for hit flashes, opaque bounds.
func _layer(image: Image) -> Dictionary:
	var used := image.get_used_rect()
	var silhouette := image.duplicate()
	var sum := Vector2.ZERO
	var count := 0
	for y in range(used.position.y, used.end.y):
		for x in range(used.position.x, used.end.x):
			var alpha := image.get_pixel(x, y).a
			if alpha < 0.5: continue
			silhouette.set_pixel(x, y, Color(1, 1, 1, alpha))
			sum += Vector2(x + 0.5, y + 0.5)
			count += 1
	return {"texture": ImageTexture.create_from_image(image), "white": ImageTexture.create_from_image(silhouette), "image": image,
		"bounds": Rect2(used.position, used.size), "center": sum / maxf(1.0, float(count)), "size": Vector2(image.get_size())}


func _remove_bow_string(image: Image) -> void:
	for y in range(image.get_height()):
		for x in [7, 8]:
			if x >= image.get_width(): continue
			var color := image.get_pixel(x, y)
			if color.a > 0.5 and color.r8 == 0xd3 and color.g8 == 0xbf: image.set_pixel(x, y, Color(0, 0, 0, 0))


## Rest-pose box of a held item in the figure's source pixels.
func _item_bounds(item: Dictionary) -> Rect2:
	var xform := Transform2D(float(item.rest), Vector2(item.hand)) * Transform2D(0.0, -Vector2(item.grip))
	var box: Rect2 = item.bounds
	var result := Rect2(xform * box.position, Vector2.ZERO)
	for corner: Vector2 in [box.position, Vector2(box.end.x, box.position.y), box.end, Vector2(box.position.x, box.end.y)]:
		result = result.expand(xform * corner)
	return result


func _finish(name: String, def: Dictionary, parts: Array[Dictionary], items: Array[Dictionary], source: Image) -> Dictionary:
	var by_id: Dictionary = {}
	for part in parts + items: by_id[part.id] = part
	var center := Vector2.ZERO
	var count := 0
	for y in range(source.get_height()):
		for x in range(source.get_width()):
			if source.get_pixel(x, y).a >= 0.5:
				center += Vector2(x + 0.5, y + 0.5)
				count += 1
	center /= maxf(1.0, float(count))
	var family: String = str(def.get("family", ""))
	return {"name": name, "family": family, "variant": str(def.get("variant", "")), "attack": str(def.get("attack", "")),
		"ground": _vec(def.get("ground", [0, 0])), "width": float(def.get("width", 10)), "center": center, "top": float(source.get_used_rect().position.y),
		"hover": float(HOVER.get(family, 0.0)), "size": Vector2(source.get_size()), "parts": parts, "items": items, "by_id": by_id,
		"material": str(def.get("material", "")), "burn": def.get("burn", {}) if def.get("burn") is Dictionary else {}, "slash": str(def.get("slash", ""))}


## Leerenrufer: the body is a flipbook of 8 frames, the eye has three states,
## both claws (one mirrored) overlap the body. All layers share a 44x44 frame.
func _build_void(data: Dictionary) -> Dictionary:
	var frame: Dictionary = data.frame
	var w := int(frame.w)
	var h := int(frame.h)
	var palette: Dictionary = data.palette
	var place := func(image: Image, at: Vector2i, flip: bool = false) -> Image:
		var canvas := Image.create(w, h, false, Image.FORMAT_RGBA8)
		var copy := image.duplicate()
		if flip: copy.flip_x()
		canvas.blend_rect(copy, Rect2i(Vector2i.ZERO, copy.get_size()), at)
		return canvas
	var body: Array[Dictionary] = []
	for path: String in data.frames:
		var image := _image(path)
		if image != null: body.append(_layer(place.call(image, Vector2i.ZERO)))
	var claw := _pixels(data.claw_left, palette)
	var pivot := _vec(data.claw_pivot)
	var shoulder := _vec(data.shoulder_left)
	var tip := _vec(data.claw_tip)
	var right_shoulder := Vector2(w - 1 - shoulder.x, shoulder.y)
	var right_x := right_shoulder.x - (claw.get_width() - 1 - pivot.x)
	var eye_at := _vec(data.eye.at)
	var eyes: Array[Dictionary] = []
	for state: String in ["closed", "half", "open"]:
		eyes.append(_layer(place.call(_pixels(data.eye[state], palette), Vector2i(eye_at))))
	var specs: Dictionary = data.get("parts", {})
	var make := func(id: String, layers: Array, fields: Dictionary) -> Dictionary:
		var part: Dictionary = layers[0].duplicate()
		part.merge(_part_fields(_spec(specs, id)), true)
		part.merge(fields, true)
		if layers.size() > 1:
			part.frames = layers
			var bounds: Rect2 = layers[0].bounds
			for layer: Dictionary in layers: bounds = bounds.merge(layer.bounds)
			part.bounds = bounds
			part.image = _union_image(layers)
		return part
	var parts: Array[Dictionary] = [
		make.call("core", body, {"pivot": Vector2(float(frame.center_x), float(frame.bottom)), "parent": "", "z": 2}),
		make.call("eye", eyes, {"pivot": eye_at + Vector2(3, 2), "parent": "core", "z": 3}),
		make.call("claw_l", [_layer(place.call(claw, Vector2i(shoulder - pivot)))], {"pivot": shoulder, "parent": "core", "z": 4, "tip": shoulder - pivot + tip + Vector2(0.5, 0.5)}),
		make.call("claw_r", [_layer(place.call(claw, Vector2i(int(right_x), int(shoulder.y - pivot.y)), true))], {"pivot": right_shoulder, "parent": "core", "z": 4,
			"tip": Vector2(right_x + (claw.get_width() - 1 - tip.x) + 0.5, shoulder.y - pivot.y + tip.y + 0.5)}),
	]
	# The open eye is the hit area; closed it is only a slit.
	parts[1].bounds = eyes[2].bounds
	parts[1].image = eyes[2].image
	var rig := _finish("void", {"family": "void", "ground": [float(frame.center_x), h - 1], "width": 20}, parts, [], _union_image(body))
	rig.eye_center = eye_at + Vector2(3.5, 2.5)
	rig.skull = ImageTexture.create_from_image(_pixels(data.skull, palette))
	rig.fps = float(frame.get("fps", 9))
	return rig


func _spec(specs: Dictionary, id: String) -> Dictionary:
	var spec: Dictionary = specs.get(id, {}).duplicate()
	spec.id = id
	return spec


func _union_image(layers: Array[Dictionary]) -> Image:
	var image: Image = layers[0].texture.get_image()
	image = image.duplicate()
	for layer: Dictionary in layers.slice(1):
		var other: Image = layer.texture.get_image()
		image.blend_rect(other, Rect2i(Vector2i.ZERO, other.get_size()), Vector2i.ZERO)
	return image


## Leerenbomber: one vital skull, a 10 fps flipbook of the sheet's frames.
func _build_bomber(data: Dictionary) -> Dictionary:
	return _build_flipbook("bomber", data, "skull")


## A one-part figure drawn as a flipbook (bomber, mimic): the family is the
## rig's name, its pose picks the frame.
func _build_flipbook(name: String, data: Dictionary, part_id: String) -> Dictionary:
	var frames: Array[Dictionary] = []
	for path: String in data.frames:
		var image := _image(path)
		if image != null: frames.append(_layer(image))
	if frames.is_empty(): return {}
	var part: Dictionary = frames[0].duplicate()
	part.merge(_part_fields(_spec(data.get("parts", {}), part_id)), true)
	part.frames = frames
	part.pivot = _vec(data.ground)
	var bounds: Rect2 = frames[0].bounds
	for layer: Dictionary in frames: bounds = bounds.merge(layer.bounds)
	part.bounds = bounds
	part.image = _union_image(frames)
	var rig := _finish(name, {"family": name, "ground": data.ground, "width": data.get("width", 8)}, [part], [], _union_image(frames))
	rig.fps = float(data.get("fps", 10))
	return rig


## Layered rig (hell_rigs.json): every part is its own full-frame PNG ("img")
## or a flipbook of them ("frames" -> part.frames, bounds and hit image are the
## union, like the Leerenrufer's core), all in one source frame of "size". The
## rig adds its debris "material", part "groups" ({id: {parts, disables}}),
## named "points" ({id: {part, at: Vector2}}) and its own size factor; wings
## add "flap" (+-1) and "swing" (Vector2 lo, hi in rad) for RigPoses. Data
## mistakes never fail the load, they are listed on the rig instead (the real
## data test asserts every list is empty): `missing` parts whose image did not
## load at all (they get an empty layer), `missing_frames` flipbooks with only
## some frames, `clipped` parts whose image is not the frame size (fitted
## top-left) and `invalid_group_members` ("group:part", see _groups). A rig
## without any loadable image is skipped.
func _build_layered(name: String, def: Dictionary) -> Dictionary:
	var frame := Vector2i(_vec(def.get("size", [0, 0])))
	var loaded: Array[Dictionary] = []
	for spec: Variant in def.get("parts", []):
		if not spec is Dictionary or not spec.has("id"): continue
		var flipbook: bool = spec.get("frames") is Array and not spec.frames.is_empty()
		var paths: Array = spec.frames if flipbook else [str(spec.get("img", ""))]
		var images: Array[Image] = []
		for path: Variant in paths:
			var image := _layer_image(str(path))
			if image == null: continue
			if frame == Vector2i.ZERO: frame = image.get_size()
			images.append(image)
		loaded.append({"spec": spec, "images": images, "flipbook": flipbook, "expected": paths.size()})
	if frame.x <= 0 or frame.y <= 0: return {}
	var parts: Array[Dictionary] = []
	var missing: Array[String] = []
	var missing_frames: Array[String] = []
	var clipped: Array[String] = []
	for entry: Dictionary in loaded:
		var spec: Dictionary = entry.spec
		var images: Array[Image] = entry.images
		if images.is_empty():
			missing.append(str(spec.id))
			images.append(Image.create(frame.x, frame.y, false, Image.FORMAT_RGBA8))
		elif images.size() < int(entry.expected):
			missing_frames.append(str(spec.id))
		var layers: Array[Dictionary] = []
		for image: Image in images:
			if image.get_size() != frame and not str(spec.id) in clipped: clipped.append(str(spec.id))
			layers.append(_layer(_fit(image, frame)))
		var part: Dictionary = layers[0].duplicate()
		part.merge(_part_fields(spec), true)
		part.disables = disabled_actions(spec.get("disables", []))
		# Wings: "flap" -1 when the membrane spreads right of the pivot (lifting it
		# is a counter-clockwise turn), "swing" [lo, hi] the turns (rad) it may
		# make before it covers the head; RigPoses.drake() applies both.
		if spec.has("flap"): part.flap = -1.0 if float(spec.flap) < 0.0 else 1.0
		if spec.get("swing") is Array and spec.swing.size() == 2: part.swing = Vector2(float(spec.swing[0]), float(spec.swing[1]))
		if bool(entry.flipbook):
			part.frames = layers
			var bounds: Rect2 = layers[0].bounds
			var union: Array[Image] = []
			for layer: Dictionary in layers:
				if Rect2(layer.bounds).has_area(): bounds = bounds.merge(layer.bounds) if bounds.has_area() else Rect2(layer.bounds)
				union.append(layer.image)
			part.bounds = bounds
			part.image = _merge_images(union, frame)
		# Legs: "sole", the heel and toe of the foot (the outermost opaque pixels
		# of its lowest two rows, at the lowest row), which RigPoses keeps on the
		# floor while the leg turns about the hip.
		if str(spec.id).begins_with("leg_"):
			var sole := _sole(part.image)
			if not sole.is_empty(): part.sole = sole
		parts.append(part)
	if missing.size() == parts.size(): return {}
	var all_images: Array[Image] = []
	for part: Dictionary in parts: all_images.append(part.image)
	var rig := _finish(name, def, parts, [], _merge_images(all_images, frame))
	# JSON numbers are floats: a generator writing "variant": 1 must still give "1".
	var variant: Variant = def.get("variant", "")
	rig.variant = str(int(variant)) if (variant is float or variant is int) and is_equal_approx(float(variant), roundf(float(variant))) else str(variant)
	rig.material = str(def.get("material", ""))
	var invalid_members: Array[String] = []
	rig.groups = _groups(def.get("groups", {}), parts, invalid_members)
	rig.points = _points(def.get("points", {}))
	rig.scale = PIXEL_SCALE * float(def.get("scale", 1.0))
	rig.fps = float(def.get("fps", 10))
	rig.missing = missing
	rig.missing_frames = missing_frames
	rig.clipped = clipped
	rig.invalid_group_members = invalid_members
	rig.layered = true
	return rig


## [heel, toe] of a foot image: the leftmost and rightmost opaque pixel centres
## (x) of its lowest two rows, both at the lowest row's index (y, the ground
## convention of hell_rigs.json); [] for an empty image.
func _sole(image: Image) -> Array[Vector2]:
	var out: Array[Vector2] = []
	var used := image.get_used_rect()
	if not used.has_area(): return out
	var bottom := used.end.y - 1
	var lo := INF
	var hi := -INF
	for y in range(maxi(used.position.y, bottom - 1), bottom + 1):
		for x in range(used.position.x, used.end.x):
			if image.get_pixel(x, y).a > 0.5:
				lo = minf(lo, x + 0.5)
				hi = maxf(hi, x + 0.5)
	if not is_finite(lo): return out
	out.assign([Vector2(lo, bottom), Vector2(hi, bottom)])
	return out


## A part image for a layered rig, at its own size: an imported texture when
## there is one, else the PNG file itself (user:// fixtures, or a res:// file
## not imported yet; an export has only the imported textures).
func _layer_image(path: String) -> Image:
	if path.is_empty(): return null
	var image: Image = _image(path) if path.begins_with("res://") else null
	if image == null:
		if not FileAccess.file_exists(path): return null
		image = Image.load_from_file(path)
		if image == null or image.is_empty(): return null
		if image.is_compressed(): image.decompress()
		image.convert(Image.FORMAT_RGBA8)
	return image


## The image on a canvas of exactly `frame` (top-left aligned, clipped).
func _fit(image: Image, frame: Vector2i) -> Image:
	if frame == Vector2i.ZERO or image.get_size() == frame: return image
	var canvas := Image.create(frame.x, frame.y, false, Image.FORMAT_RGBA8)
	canvas.blit_rect(image, Rect2i(Vector2i.ZERO, image.get_size()), Vector2i.ZERO)
	return canvas


## Alpha-blends full-frame images into one (the rig's silhouette).
func _merge_images(images: Array[Image], frame: Vector2i) -> Image:
	var result := Image.create(frame.x, frame.y, false, Image.FORMAT_RGBA8)
	for image: Image in images: result.blend_rect(image, Rect2i(Vector2i.ZERO, image.get_size()), Vector2i.ZERO)
	return result


## {group id: {"parts": Array[String], "disables": Array[String]}}; parts that
## name a group join it even when the group's list forgets them. A member that
## can never be lost (no such part, or hp <= 0, so never in parts_lost) would
## keep the group from ever firing: it is dropped, appended to `invalid` as
## "group:part" and warned about.
func _groups(value: Variant, parts: Array[Dictionary], invalid: Array[String] = []) -> Dictionary:
	var hp_of: Dictionary = {}
	for part: Dictionary in parts: hp_of[str(part.id)] = float(part.hp)
	var result: Dictionary = {}
	if value is Dictionary:
		for id: Variant in value:
			var group: Variant = value[id]
			if not group is Dictionary: continue
			var members: Array[String] = []
			var listed: Variant = group.get("parts", [])
			for member: Variant in (listed if listed is Array else []):
				if str(member) in members: continue
				if float(hp_of.get(str(member), 0.0)) <= 0.0:
					invalid.append("%s:%s" % [str(id), str(member)])
					push_warning("hell_rigs.json: group '%s' member '%s' can never be lost (no such part or hp 0), dropped" % [str(id), str(member)])
					continue
				members.append(str(member))
			result[str(id)] = {"parts": members, "disables": disabled_actions(group.get("disables", []))}
	for part: Dictionary in parts:
		var group_id := str(part.group)
		if group_id.is_empty(): continue
		if float(part.hp) <= 0.0:
			var entry := "%s:%s" % [group_id, str(part.id)]
			if not entry in invalid:
				invalid.append(entry)
				push_warning("hell_rigs.json: part '%s' of group '%s' has hp 0 and can never be lost, not a member" % [str(part.id), group_id])
			continue
		if not result.has(group_id): result[group_id] = {"parts": [] as Array[String], "disables": [] as Array[String]}
		if not str(part.id) in result[group_id].parts: result[group_id].parts.append(str(part.id))
	return result


## {point id: {"part": String, "at": Vector2}} in source pixels of the rest pose.
func _points(value: Variant) -> Dictionary:
	var result: Dictionary = {}
	if not value is Dictionary: return result
	for id: Variant in value:
		var point: Variant = value[id]
		if point is Dictionary: result[str(id)] = {"part": str(point.get("part", "")), "at": _vec(point.get("at", [0, 0]))}
	return result


# --------------------------------------------------------------- host queries

## HP weights of all breakable parts and items (id -> weight).
func weights(name: String) -> Dictionary:
	var result: Dictionary = {}
	var data := rig(name)
	for part: Dictionary in data.get("parts", []) + data.get("items", []):
		if float(part.hp) > 0: result[part.id] = float(part.hp)
	return result


## World px from the feet (the ground point) to point `id` of rig `name` in
## its rest pose, facing right (mirror x for a figure facing left): one of the
## rig's points (hell_rigs.json "points": mouth, throat, hand, tail_tip, core),
## "feet" (zero) or "top" (the highest opaque row above the feet). Ignaroth's
## atlas frames (hell_monsters.json drache1..4) stand on the same feet at their
## bottom centre and share the rig's scale, so a host drawing either one aims
## its breath, bolts and bursts from these instead of from the frame size.
## Vector2.INF when the rig or point is unknown.
func foot_offset(name: String, id: String) -> Vector2:
	var data := rig(name)
	if data.is_empty(): return Vector2.INF
	var ground: Vector2 = data.ground
	var scale := float(data.get("scale", PIXEL_SCALE))
	if id == "feet": return Vector2.ZERO
	if id == "top": return Vector2(0.0, (float(data.get("top", ground.y)) - ground.y) * scale)
	var points: Dictionary = data.get("points", {})
	if not points.has(id): return Vector2.INF
	return (Vector2(points[id].at) - ground) * scale


## Maps a world point to the rig's source pixels for an actor whose body
## centre is at `origin` and who faces `face` (+1 right, -1 left).
func to_source(name: String, origin: Vector2, face: float, point: Vector2) -> Vector2:
	var data := rig(name)
	if data.is_empty(): return Vector2.ZERO
	var ground: Vector2 = data.ground
	var center: Vector2 = data.center
	var sign := -1.0 if face < 0.0 else 1.0
	# Floating figures are drawn `hover` pixels higher than their rest pose.
	var scale := float(data.get("scale", PIXEL_SCALE))
	return Vector2(ground.x + (point.x - origin.x) / scale * sign, center.y + float(data.hover) + (point.y - origin.y) / scale)


## The breakable part with an opaque rest-pose pixel nearest to a world point,
## within `reach` world pixels (a projectile's radius). Only ids in `alive`
## count, and `exposed` parts only while their action is `active`. Ties go to
## the part drawn in front. Returns "" when no part is that close.
func part_at(name: String, origin: Vector2, face: float, point: Vector2, alive: Dictionary, active: String = "", reach: float = 2.0) -> String:
	var data := rig(name)
	if data.is_empty(): return ""
	var local := to_source(name, origin, face, point)
	var radius := maxf(0.5, reach / float(data.get("scale", PIXEL_SCALE)))
	var best := ""
	var best_distance := INF
	var best_z := -999
	for part: Dictionary in data.parts + data.items:
		if not alive.has(part.id): continue
		if not str(part.exposed).is_empty() and str(part.exposed) != active: continue
		var distance := _pixel_distance(part, local, radius)
		if distance < best_distance - 0.01 or (distance < best_distance + 0.01 and distance < INF and int(part.z) > best_z):
			best = part.id
			best_distance = distance
			best_z = int(part.z)
	return best


## Distance from a source point to the part's nearest opaque pixel centre, or
## INF beyond `radius`. Items are tested in their own rest-pose frame.
func _pixel_distance(part: Dictionary, local: Vector2, radius: float) -> float:
	var image: Image = part.get("image")
	if image == null: return INF
	var probe := local
	if bool(part.is_item):
		probe = (Transform2D(float(part.rest), Vector2(part.hand)) * Transform2D(0.0, -Vector2(part.grip))).affine_inverse() * local
	var best := INF
	var span := int(ceil(radius))
	var base := Vector2i(floori(probe.x), floori(probe.y))
	for dy in range(-span, span + 1):
		for dx in range(-span, span + 1):
			var pixel := base + Vector2i(dx, dy)
			if pixel.x < 0 or pixel.y < 0 or pixel.x >= image.get_width() or pixel.y >= image.get_height(): continue
			if image.get_pixelv(pixel).a < 0.5: continue
			var distance := probe.distance_to(Vector2(pixel) + Vector2(0.5, 0.5))
			if distance <= radius + 0.71 and distance < best: best = distance
	return best


## The living part nearest to a world point (for melee, splash and fallbacks).
## Parts without pixels (a layered part whose image is missing) are never
## picked: nobody could see them take the hit or break.
func nearest_part(name: String, origin: Vector2, face: float, point: Vector2, alive: Dictionary, active: String = "") -> String:
	var close := part_at(name, origin, face, point, alive, active, 48.0)
	if not close.is_empty(): return close
	# Far away: the part whose box is nearest.
	var data := rig(name)
	if data.is_empty(): return ""
	var local := to_source(name, origin, face, point)
	var best := ""
	var best_distance := INF
	for part: Dictionary in data.parts + data.items:
		if not alive.has(part.id): continue
		if not str(part.exposed).is_empty() and str(part.exposed) != active: continue
		var area: Rect2 = part.bounds
		if not area.has_area(): continue
		var distance := local.distance_squared_to(local.clamp(area.position, area.end))
		if distance < best_distance:
			best = part.id
			best_distance = distance
	return best
