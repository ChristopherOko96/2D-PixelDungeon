extends "res://tests/soul_guardian_commands_test.gd"
## Host integration: finite real blood, articulated forms, corpse ownership and curses.
func _run() -> void:
	game = Game.new()
	root.add_child(game)
	await process_frame
	game.set_process(false)
	game.set_physics_process(false)
	game.view.set_audio_enabled(false)
	game.players[1] = {"pos": Vector2(300, 240), "class_id": "necromancer", "hp": 100, "max_hp": 100, "damage": 10.0, "aim": Vector2.RIGHT}
	game.current_layout = {"id": "blood-curse", "tile_size": 32, "play_bounds": [0, 0, 1408, 704], "world_size": [1408, 704], "obstacles": []}
	game.phase = "combat"
	tc = game.talent_combat
	d = tc.data
	check(not game._build_session_identity().is_empty(), "new data fingerprints preserve valid session admission identity")
	check(str(d.talents.minion_11.type) == "death_pact", "minion pact replaces duplicate movement")
	check(str(d.talents.curse_11.type) == "curse_harvest", "curse harvest replaces duplicate movement")
	var rt := _setup(d.talents.minion_14)
	var pet: Dictionary = tc.permanent_pet(1)
	game.boss_moves.zones.clear()
	var at := Vector2(pet.pos)
	tc._pool_at(1, "blood", at, 32.0, 12.0, 0.0, "")
	_tick(0.25)
	check(float(pet.get("blood", 0.0)) == 0 and float(pet.get("blood_pending",0))>0, "blood first forms visibly before gradual uptake")
	check(game.boss_moves.zones.size() == 1 and float(game.boss_moves.zones[0].timer) > 0, "real source stays present during uptake")
	_tick(3.0)
	var once := float(pet.get("blood", 0.0))
	_tick(3.0)
	check(is_equal_approx(float(pet.get("blood", 0.0)), once) and once <= 25.01, "expired blood cannot refill twice")
	for i in range(3):
		tc._pool_at(1, "blood", Vector2(pet.pos), 32.0, 12.0, 0.0, "")
		_tick(3.0)
	check(str(pet.kind)=="bone_warrior" and _cast(d.talents.minion_14),"full gauge waits for explicit ultimate")
	check(str(pet.get("rig", "")) == "blood_colossus", "full blood transforms into existing large skeletal source rig")
	check(pet.parts.has("arm_l") and pet.parts.has("arm_r") and pet.parts.has("skull"), "large skeleton has independent arms skull torso and legs")
	check(float(pet.get("blood_form", 0.0)) > 0 and tc.snapshot().pets[0].has("blood"), "form and gauge replicate as host snapshot primitives")
	var pose: Dictionary = preload("res://src/rig/rig_poses.gd").skeleton(preload("res://src/rig/rig_library.gd").shared().rig("blood_colossus"), {"t":0.0,"ct":0.0,"moving":false,"lost":{},"u":0.4,"clip":"stomp"})
	check(float(pose.parts.leg_r.dy) < -5.0 and absf(float(pose.parts.arm_l.rot)) > 0.1, "stomp poses independent raised leg and balancing arm")
	tc.room_changed()
	check(tc.permanent_pet(1) == pet, "permanent skeleton survives room transfer")
	_tick(24.0)
	check(str(pet.rig) == "bone_warrior" and float(pet.get("blood", -1.0)) == 0.0, "large form expires without free health refill")
	rt = _setup(d.talents.minion_7)
	var dead := _dummy(Vector2(390, 240))
	dead.hp = 0
	tc.enemy_killed(dead, 1)
	tc.enemy_killed(dead, 1)
	check(tc.snapshot().get("corpses", []).size() == 1, "one owner corpse per real death callback")
	_cast(d.talents.minion_7)
	check(tc.snapshot().get("corpses", []).is_empty(), "corpse explosion spends marker atomically")
	check(game.boss_moves.zones.any(func(z: Dictionary) -> bool: return str(z.style) == "blood" and float(z.timer) > 0), "corpse burst makes actual existing blood medium")
	rt = _setup(d.talents.curse_1)
	var undead := _dummy(Vector2(400, 240))
	undead.kind = "skeleton"
	tc.bullet_hit({"owner": 1, "talent": "curse_1", "damage": 10.0, "style": "arcane"}, undead)
	var hp := float(undead.hp)
	_tick(1.1)
	check(float(undead.hp) < hp, "magical decay damages undead independently of poison immunity")
	check(game.boss_moves.zones.any(func(z: Dictionary) -> bool: return str(z.style) == "poison" and float(z.timer) > 0), "curse projectile leaves real poison medium")
	rt = _setup(d.talents.curse_9)
	game.players[1].hp = 50
	var victim := _dummy(Vector2(370, 240))
	tc.bullet_hit({"owner": 1, "talent": "curse_9", "damage": 10.0, "style": "arcane"}, victim)
	for i in range(10): tc._hit(1, victim, 100.0, {}, rt, "curse_1")
	check(float(game.players[1].hp) + float(rt.debt_heal) <= 52.001, "lifedrain aggregate capped at two percent max health per second")
	check(float(game.players[1].hp) + float(rt.debt_heal) > 50.0, "own resolved damage really heals instead of only satisfying an upper bound")
	var hp_before := float(game.players[1].hp) + float(rt.debt_heal)
	tc.dealt(1, victim, 99999.0, true, 0.0)
	check(is_equal_approx(float(game.players[1].hp) + float(rt.debt_heal), hp_before), "zero resolved damage cannot heal")
	# A fresh tiny victim proves that overkill contributes only its remaining HP.
	rt.drain_credit = 2.0
	var tiny := _dummy(Vector2(390, 240))
	tiny.hp = 0.1
	hp_before = float(game.players[1].hp) + float(rt.debt_heal)
	tc._hit(1, tiny, 9999.0, d.talents.curse_9, rt, "curse_9")
	check(float(game.players[1].hp) + float(rt.debt_heal) - hp_before <= 0.021, "lethal surplus never heals as thousands of damage")
	rt = _setup(d.talents.minion_11)
	pet = tc.permanent_pet(1)
	check(_cast(d.talents.minion_11) and rt.buffs.has("death_pact"), "learned pact uses real living permanent skeleton")
	var pet_hp := float(pet.hp)
	var transferred: int = tc.incoming(1, 10, Vector2.RIGHT)
	check(transferred < 10 and float(pet.hp) < pet_hp, "pact reduction is actually paid by the companion")
	pet.hp = 0.0
	rt.debt_in = 0.0
	check(tc.incoming(1, 10, Vector2.RIGHT) >= 9, "dead companion cannot absorb further hero damage")
	rt = _setup(d.talents.curse_7)
	game.boss_moves.zones.clear()
	check(_cast(d.talents.curse_7), "seuchenfeld casts")
	check(str(tc.zones[0].look) == "external_pool", "magic zone does not draw duplicate custom puddle")
	var field_at := Vector2(tc.zones[0].pos)
	check(tc.necromancer.consume_poison(tc, 2, field_at, 200, 3) == 0, "another owner cannot harvest this poison")
	check(tc.necromancer.consume_poison(tc, 1, field_at, 200, 3) == 1, "own real poison can be harvested once")
	check(float(tc.zones[0].dmg) == 0.0 and float(tc.zones[0].time) == 0.0, "consumed field cannot leave invisible damage behind")
	check(tc.necromancer.consume_poison(tc, 1, field_at, 200, 3) == 0, "spent poison cannot be reused")
	rt = _setup(d.talents.minion_14)
	pet = tc.permanent_pet(1)
	pet.blood = 50.0
	check(_cast(d.talents.minion_14), "ultimate uses half blood from living warrior")
	check(str(tc.command_pet(1).get("kind", "")) == "blood_colossus" and tc.player_state(1).pet.abilities[0].id == "bone_stomp", "transformed warrior owns command slots")
	check(not tc.pet_cast(1,0,true), "assembling skeleton cannot strike before its limbs are attached")
	_tick(1.2)
	check(tc.pet_cast(1, 0, true), "large skeleton accepts manual stomp")
	_tick(1.0)
	check(float(rt.pet_cds.bone_stomp) < 7.0, "companion command cooldown advances")
	_tick(21.0)
	check(str(tc.command_pet(1).kind)=="bone_warrior" and float(pet.blood)==0, "spent blood returns the same warrior to normal")
	rt = _setup(d.talents.curse_1)
	game.boss_moves.zones.clear()
	var living := _dummy(Vector2(450, 260))
	var immune := _dummy(Vector2(450, 260))
	immune.kind = "skelet"
	tc.necromancer.pool(tc, 1, "poison", living.pos, 40, 5)
	game.boss_moves.update(0.1)
	check(living.statuses.has("poison"), "actual friendly poison medium poisons vulnerable enemies")
	check(not immune.statuses.has("poison") and float(immune.hp) == float(immune.max_hp), "biological poison immunity remains intact for undead")
	game.queue_free()
	await process_frame
	print("NECRO_BLOOD_CURSE checked=%d failures=%d" % [checked, failures.size()])
	quit(0 if failures.is_empty() else 1)
